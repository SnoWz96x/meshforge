# ============================================================
# MeshForge — variáveis de ambiente (copie para .env)
# ============================================================

# --- Banco de dados ---
POSTGRES_USER=meshforge
POSTGRES_PASSWORD=meshforge
POSTGRES_DB=meshforge
# 5433 p/ não conflitar com um PostgreSQL nativo na 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql://meshforge:meshforge@localhost:5433/meshforge?schema=public

# --- Redis / Filas ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Storage (MinIO / S3-compatible) ---
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_PATH=./storage
MINIO_ROOT_USER=meshforge
MINIO_ROOT_PASSWORD=meshforge123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=meshforge
S3_ACCESS_KEY=meshforge
S3_SECRET_KEY=meshforge123

# --- API ---
API_PORT=3001
WEB_PORT=3000
# URL da API consumida pelo front-end (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- GPU backend ---
# zluda (AMD/Windows) | rocm (AMD/Linux/WSL2) | cuda (NVIDIA) | directml
GPU_BACKEND=zluda
GPU_BACKEND_3D=zluda            # fallback cirúrgico: rocm (WSL2) se o Hunyuan3D falhar via zluda

# --- Serviços de IA (endpoints) ---
COMFYUI_URL=http://localhost:8188
HUNYUAN3D_URL=http://localhost:8189

# --- Ferramentas externas ---
HF_TOKEN=                       # token HuggingFace (opcional, p/ modelos gated)
CIVITAI_TOKEN=                  # token Civitai (opcional)
POLY_PIZZA_KEY= # opcional: chave grátis (poly.pizza/api) → habilita a fonte Poly Pizza (8000+ low-poly)
